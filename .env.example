# ──────────────────────────────────────────────────────────────────────────
# Soma — variables d'environnement
#
# Copie ce fichier en `.env` pour le développement local.
# Les deux valeurs ci-dessous sont PUBLIQUES par conception : la clé `anon`
# de Supabase est destinée au navigateur et n'ouvre l'accès qu'aux lignes
# autorisées par la Row Level Security (voir supabase/schema.sql).
#
# N'écris JAMAIS ici la clé `service_role` : elle contourne la RLS.
# Sans ces variables, l'app fonctionne à 100 % en local, avec un bandeau
# discret « Sync désactivée ».
# ──────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chemin de base du site. Pour GitHub Pages : /<nom-du-depot>/
# (le workflow GitHub Actions le calcule automatiquement).
# VITE_BASE=/soma/
